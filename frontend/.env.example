# Frontend — variáveis públicas (expostas ao browser com prefixo VITE_)
# Valores para o projeto Firebase "cofrito"
# As credenciais abaixo são PÚBLICAS (Firebase usa API key pública por design),
# mas atenção: as rules de Firestore são a segurança real, não a API key.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=cofrito.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cofrito
VITE_FIREBASE_STORAGE_BUCKET=cofrito.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=941013755211
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_FUNCTIONS_REGION=southamerica-east1

VITE_PUBLIC_URL=http://localhost:5173
VITE_API_BASE_URL=https://southamerica-east1-cofrito.cloudfunctions.net
VITE_COFRITO_DOMAIN=cofrito.web.app
VITE_SENTRY_DSN=
VITE_COFRITO_VERSION=0.0.1
VITE_TENANT=caocipp
