# ============================================
#  Agente Cofrito — .gitignore
# ============================================

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.npm/

# Build artifacts
dist/
build/
.next/
out/
.tsbuildinfo
*.tsbuildinfo
.cache/
.parcel-cache/

# Coverage
coverage/
.nyc_output/
*.lcov

# Environment
.env
.env.local
.env.development
.env.test
.env.production
!.env.example
!.env.*.example

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
*-debug.log
serviceAccountKey.json
*-firebase-adminsdk-*.json
gcp-service-account.json

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local data
data/processed/*.json
data/processed/*.parquet
data/embeddings/*.npy
data/embeddings/*.pkl
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/embeddings/.gitkeep

# Logs
logs/
*.log

# Tests
test-results/
playwright-report/
.playwright/

# OS
.DS_Store
.AppleDouble
.LSOverride
Icon?
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
Thumbs.db
