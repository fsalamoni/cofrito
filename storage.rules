rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // PDFs originais do corpus
    match /corpus/{allPaths=**} {
      allow read: if request.auth != null;
      // Admin pode fazer upload, mas com limites de tamanho
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && request.resource.size < 50 * 1024 * 1024; // 50MB max
    }

    // Anexos de consultas formais (somente owner + admin)
    match /consultas/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Respostas oficiais (somente admin)
    match /respostas/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false; // só admin
    }
  }
}
