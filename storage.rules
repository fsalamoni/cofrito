rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // PDFs originais do corpus (somente leitura autenticada)
    match /corpus/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false; // upload só via Admin SDK
    }

    // Anexos de consultas formais (somente owner + admin)
    match /consultas/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Respostas oficiais (somente admin)
    match /respostas/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false; // só admin
    }
  }
}
