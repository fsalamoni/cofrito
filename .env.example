# ============================================
#  Variáveis de ambiente (exemplo) — Cofrito
# ============================================
# Copie para .env.local e preencha os valores reais
# NUNCA comite .env.local
#
# Projeto Firebase: cofrito (número 941013755211)

# --- Google AI (Gemini) ---
# Obtenha em https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# --- Firebase Admin SDK (para ingestão local) ---
# Caminho para o service account JSON do Firebase
# Baixe em Firebase Console → Project Settings → Service Accounts → Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
FIREBASE_PROJECT_ID=cofrito
FIREBASE_CONFIG={"projectId":"cofrito","databaseURL":"https://cofrito.firebaseio.com"}

# --- Email (Resend) ---
# Obtenha em https://resend.com/api-keys
RESEND_API_KEY=re_xxxx
RESEND_FROM=no-reply@cofrito.web.app
CAO_EMAIL=caocivel@mprs.mp.br

# --- Sentry (opcional) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Feature flags ---
FEATURE_V2_RAG=true
FEATURE_V2_VECTOR_SEARCH=true
FEATURE_V2_CONSULTA_FORMAL=true
FEATURE_V2_ADMIN_PANEL=true
FEATURE_LGPD_CONSENT=true

# --- Limites ---
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_CONSULTA_PER_DAY=5
RATE_LIMIT_DELETE_ACCOUNT_PER_DAY=1
CONVERSATION_RETENTION_DAYS=365
CONSULTA_RETENTION_DAYS=1825

# --- Domínio ---
# Dev local:  http://localhost:5173
# Produção:   https://cofrito.web.app
PUBLIC_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000,https://cofrito.web.app
COFRITO_DOMAIN=cofrito.web.app
COFRITO_VERSION=0.0.1
