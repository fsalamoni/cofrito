# ============================================
#  Variáveis de ambiente (exemplo)
# ============================================
# Copie para .env.local e preencha os valores reais
# NUNCA comite .env.local

# --- Google AI (Gemini) ---
# Obtenha em https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# --- Firebase Admin SDK (para ingestão local) ---
# Caminho para o service account JSON do Firebase
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
FIREBASE_PROJECT_ID=agente-caocipp-dev
FIREBASE_CONFIG={"projectId":"agente-caocipp-dev","databaseURL":"https://agente-caocipp-dev.firebaseio.com"}

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxx
RESEND_FROM=no-reply@cofrito.caocipp.mp.rs.gov.br
CAO_EMAIL=caocivel@mprs.mp.br

# --- Sentry (opcional) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Feature flags ---
FEATURE_V2_RAG=true
FEATURE_V2_VECTOR_SEARCH=true
FEATURE_V2_CONSULTA_FORMAL=true
FEATURE_V2_ADMIN_PANEL=true
FEATURE_LGPD_CONSENT=true

# --- Limites ---
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_CONSULTA_PER_DAY=5
RATE_LIMIT_DELETE_ACCOUNT_PER_DAY=1
CONVERSATION_RETENTION_DAYS=365
CONSULTA_RETENTION_DAYS=1825

# --- Domínio ---
# Dev:    http://localhost:5173
# Staging: https://cofrito-staging.web.app
# Prod:   https://cofrito-prod.web.app (ou cofrito.web.app, a definir)
PUBLIC_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000,https://cofrito-staging.web.app,https://cofrito-prod.web.app
COFRITO_DOMAIN=cofrito.web.app
COFRITO_VERSION=0.0.0
