{
  "name": "@agente-caocipp/functions",
  "version": "0.0.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "deploy": "firebase deploy --only functions",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ingest": "npm run build && node lib/scripts/ingest.js",
    "validate:corpus": "npm run build && node lib/scripts/validate-corpus.js",
    "golden-set": "npm run build && node lib/scripts/run-golden-set.js",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@google-cloud/vertexai": "^1.5.0",
    "@google/generative-ai": "^0.17.0",
    "@sendgrid/mail": "^8.1.3",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.4.5",
    "firebase-admin": "^12.3.0",
    "firebase-functions": "^5.0.1",
    "gray-matter": "^4.0.3",
    "mammoth": "^1.7.2",
    "pdf-parse": "^1.1.1",
    "resend": "^3.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/sendgrid__mail": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.5.3",
    "vitest": "^2.0.0"
  }
}
