rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    //  Helper functions
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdminMaster() {
      // Admin master = o único admin com uid específico (definido via admin script).
      // Por padrão, o primeiro admin criado vira master. Outros admins não
      // conseguem mexer em admin-config.
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'master';
    }

    function hasAcceptedConsent() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.consent != null;
    }

    function isValidUserUpdate() {
      let allowed = ['displayName', 'preferences', 'lastSeen', 'unidade', 'areasAtuacao', 'llmConfig'];
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(allowed);
    }

    // LLM config — campos permitidos
    function isValidLLMConfig() {
      let allowed = ['provider', 'model', 'apiKey', 'enabled', 'updatedAt'];
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(allowed);
    }

    // ============================================================
    //  Users (próprio) — dados 100% isolados por usuário
    // ============================================================

    match /users/{uid} {
      // Doc principal do user
      allow read, delete: if isOwner(uid);

      allow create: if isOwner(uid) &&
        request.resource.data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'consent']) &&
        request.resource.data.email is string &&
        request.resource.data.displayName is string &&
        request.resource.data.consent != null;

      allow update: if isOwner(uid) && isValidUserUpdate();

      // Profile detalhado
      match /profile/main {
        allow read, write: if isOwner(uid);
      }

      // Configurações pessoais do user
      match /settings/{settingId} {
        allow read, write: if isOwner(uid);
      }

      // Configuração de LLM pessoal do user
      match /settings/llm {
        allow read, write: if isOwner(uid) && isValidLLMConfig();
      }

      // Preferências (tema, idioma, etc)
      match /settings/preferences {
        allow read, write: if isOwner(uid);
      }

      // Conversations
      match /conversations/{conversationId} {
        allow read, write: if isOwner(uid);

        match /messages/{messageId} {
          allow read, write: if isOwner(uid);
        }
      }

      // Feedback
      match /feedback/{feedbackId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ============================================================
    //  Admins — dados pessoais do admin
    // ============================================================

    match /admins/{uid} {
      // Doc principal (registra quem é admin)
      allow read: if isOwner(uid);
      allow write: if false; // somente via admin script

      // Configurações PESSOAIS do admin (separadas das globais)
      match /settings/{settingId} {
        allow read, write: if isOwner(uid) && isAdmin();
      }

      // LLM pessoal do admin
      match /settings/llm {
        allow read, write: if isOwner(uid) && isAdmin() && isValidLLMConfig();
      }
    }

    // ============================================================
    //  Admin Config GLOBAL — apenas admin master
    // ============================================================
    // Aqui ficam configs que afetam TODA a plataforma.
    // Quando o master configura, sobrescreve o user.

    match /admin-config/{configId} {
      // Lê qualquer admin (info) E o próprio user (saber se há config global)
      allow read: if isAdmin() || isSignedIn();
      // Escreve só o master
      allow write: if isAdminMaster();
    }

    // ============================================================
    //  Corpus (acervo público para leitura autenticada)
    // ============================================================
    // docs inseridos pelo admin master formam a base de conhecimento
    // do Cofrito. Leitura: qualquer user autenticado com consent.
    // Escrita: só admin (master ou não).

    match /corpus/{document=**} {
      allow read: if hasAcceptedConsent();
      allow write: if isAdmin();
    }

    // Sources (metadados de fontes: pastas, links, redes)
    match /corpus/sources/{sourceId} {
      allow read: if hasAcceptedConsent();
      allow write: if isAdmin();
    }

    // Uploaded (documentos enviados pelo admin)
    match /corpus/uploaded/{docId} {
      allow read: if hasAcceptedConsent();
      allow write: if isAdmin();

      match /chunks/{chunkId} {
        allow read: if hasAcceptedConsent();
        allow write: if isAdmin();
      }
    }

    // ============================================================
    //  Consultas formais
    // ============================================================

    match /consultas-formais/{consultaId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasAll([
          'protocol', 'userId', 'assunto', 'questaoObjetiva',
          'createdAt', 'status'
        ]) &&
        request.resource.data.questaoObjetiva is string &&
        request.resource.data.questaoObjetiva.size() >= 20 &&
        request.resource.data.assunto is string &&
        request.resource.data.assunto.size() >= 5;

      allow update, delete: if isAdmin();
    }

    // ============================================================
    //  Auditoria (somente escrita pelo backend)
    // ============================================================

    match /audit/{auditId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ============================================================
    //  Feature flags
    // ============================================================

    match /feature-flags/{flagKey} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ============================================================
    //  System (agregações, métricas)
    // ============================================================

    match /system/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ============================================================
    //  Negação default: qualquer path não especificada = DENY
    // ============================================================
    // Regras de Firestore têm deny-by-default. Paths fora desta lista
    // são inacessíveis.
  }
}
